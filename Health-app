import React, { useState } from "react"; import { BrowserRouter as Router, Routes, Route, Link, useNavigate } from "react-router-dom";

// --- Sign Up Page --- function SignUp() { const [name, setName] = useState(""); const [age, setAge] = useState(""); const [gender, setGender] = useState(""); const [location, setLocation] = useState(""); const navigate = useNavigate();

const handleSubmit = (e) => { e.preventDefault(); navigate("/questionnaire"); };

return ( <div className="flex flex-col items-center justify-center min-h-screen p-6 bg-gray-100"> <h1 className="text-2xl font-bold mb-4">Sign Up</h1> <form onSubmit={handleSubmit} className="flex flex-col gap-3 bg-white p-6 rounded-lg shadow-md"> <input className="border p-2 rounded" placeholder="Name" value={name} onChange={(e) => setName(e.target.value)} /> <input className="border p-2 rounded" placeholder="Age" value={age} onChange={(e) => setAge(e.target.value)} /> <input className="border p-2 rounded" placeholder="Gender" value={gender} onChange={(e) => setGender(e.target.value)} /> <input className="border p-2 rounded" placeholder="Location" value={location} onChange={(e) => setLocation(e.target.value)} /> <button type="submit" className="bg-blue-500 text-white p-2 rounded">Start</button> </form> </div> ); }

// --- Questionnaire + BMI --- function Questionnaire() { const [height, setHeight] = useState(""); const [weight, setWeight] = useState(""); const [bmi, setBmi] = useState(null); const [category, setCategory] = useState(""); const navigate = useNavigate();

const calculateBMI = (e) => { e.preventDefault(); const h = parseFloat(height) / 100; const w = parseFloat(weight); if (h && w) { const result = (w / (h * h)).toFixed(1); setBmi(result); if (result < 18.5) setCategory("Underweight"); else if (result < 24.9) setCategory("Normal"); else if (result < 29.9) setCategory("Overweight"); else setCategory("Obese"); } };

return ( <div className="flex flex-col items-center justify-center min-h-screen p-6 bg-gray-100"> <h1 className="text-2xl font-bold mb-4">Health Questionnaire</h1> <form onSubmit={calculateBMI} className="flex flex-col gap-3 bg-white p-6 rounded-lg shadow-md"> <input className="border p-2 rounded" placeholder="Height (cm)" value={height} onChange={(e) => setHeight(e.target.value)} /> <input className="border p-2 rounded" placeholder="Weight (kg)" value={weight} onChange={(e) => setWeight(e.target.value)} /> <button type="submit" className="bg-green-500 text-white p-2 rounded">Calculate BMI</button> </form> {bmi && ( <div className="mt-4 p-4 bg-green-100 rounded"> <p>Your BMI: {bmi}</p> <p>Category: {category}</p> <button onClick={() => navigate("/dashboard")} className="mt-2 bg-blue-500 text-white px-4 py-2 rounded">Go to Dashboard</button> </div> )} </div> ); }

// --- Dashboard --- function Dashboard() { return ( <div className="flex flex-col items-center justify-center min-h-screen bg-gray-100 p-6"> <h1 className="text-2xl font-bold mb-6">Dashboard</h1> <div className="grid grid-cols-2 gap-4 w-full max-w-md"> <Link to="/bmi"><button className="bg-yellow-300 p-6 rounded-lg shadow-md w-full">BMI Snapshot</button></Link> <Link to="/food"><button className="bg-pink-300 p-6 rounded-lg shadow-md w-full">Food Guidance</button></Link> <Link to="/exercise"><button className="bg-blue-300 p-6 rounded-lg shadow-md w-full">Exercise</button></Link> <Link to="/mind"><button className="bg-purple-300 p-6 rounded-lg shadow-md w-full">Mind & Motivation</button></Link> </div> </div> ); }

// --- Placeholder pages --- function Food() { return <h2 className="p-6">Food Guidance Page</h2>; } function Exercise() { return <h2 className="p-6">Exercise Page</h2>; } function Mind() { return <h2 className="p-6">Mind & Motivation Page</h2>; } function BMIpage() { return <h2 className="p-6">BMI Snapshot Page</h2>; }

// --- Main App --- export default function App() { return ( <Router> <Routes> <Route path="/" element={<SignUp />} /> <Route path="/signup" element={<SignUp />} /> <Route path="/questionnaire" element={<Questionnaire />} /> <Route path="/dashboard" element={<Dashboard />} /> <Route path="/food" element={<Food />} /> <Route path="/exercise" element={<Exercise />} /> <Route path="/mind" element={<Mind />} /> <Route path="/bmi" element={<BMIpage />} /> </Routes> </Router> ); }

